FROM public.ecr.aws/docker/library/python:3.14-slim

COPY --from=ghcr.io/astral-sh/uv:0.8.18 /uv /usr/local/bin/uv

WORKDIR /app

COPY pyproject.toml uv.lock ./
COPY packages ./packages
COPY services ./services

RUN uv sync --frozen --no-dev --package api

ENV PATH="/app/.venv/bin:$PATH"

# Workspace members are installed editable, so the source bind-mounted by
# docker-compose is what runs; --reload restarts uvicorn when it changes.
CMD ["uvicorn", "api.main:app", "--host", "0.0.0.0", "--port", "8000", \
     "--reload", \
     "--reload-dir", "/app/packages/core/src", \
     "--reload-dir", "/app/packages/utils/src", \
     "--reload-dir", "/app/services/api/src"]